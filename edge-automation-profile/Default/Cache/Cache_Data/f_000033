			<tr a-code="{{:code}}" a-capacity="{{:capacity}}">
			  <td>{{:text}}</td>
			  <td><span class="txt size">{{:~byteUnit(capacity)}}</span></td>
			  <td><span class="txt num"><em>{{:unseen}}</em>/{{:count}}</span></td>
			  <td>
				<button type="button" class="button sm d-empty" title="비우기"{{if count === 0}} disabled{{/if}}><i class="icon-empty"></i><span><!--비우기-->{{:~extns.Empty}}</span></button>
				<button type="button" class="button sm d-backup" title="백업"{{if count === 0}} disabled{{/if}}><i class="icon-history"></i><span><!--백업-->{{:~extns.Backup}}</span></button>
