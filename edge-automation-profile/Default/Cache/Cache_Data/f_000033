			  <input type="text" class="int"{{if code === "subject"}} value={{:data}}{{/if}}>
			  <span><!--포함되어 있을 경우 전달-->{{:_extns.ForwardTitle_Next}}</span>
			</label>
		  </li>
		</ul>
	  </dd>
	</dl>
	<dl>
	  <dt><!--기간-->{{:_extns.Period}}</dt>
	  <dd>
		<div class="dateEtcCheck">
		  <label class="checkbox"><input type="radio" name="dialog_forwarding_period"{{if start === "" && end === ""}} checked{{/if}}><i></i><span><!--기간제한 없음-->{{:_extns.NoPeriodLimit}}</span></label>
		  <label class="checkbox etc"><input type="radio" name="dialog_forwarding_period"{{if start !== "" || end !== ""}} checked{{/if}}><i></i><span><!--기간입력-->{{:_extns.PeriodInput}}</span></label>
		  <div class="iDate_area hidden">
			<div class="iDate date{{if start === "" && end === ""}} disabled{{/if}}"><input type="text" class="int iDateStart d-datetimepicker"{{if start === "" && end === ""}} disabled{{else}} value={{:start}}{{/if}}></div>
			<span class="space">~</span>
			<div class="iDate date{{if start === "" && end === ""}} disabled{{/if}}"><input type="text" class="int iDateEnd d-datetimepicker"{{if start === "" && end === ""}} disabled{{else}} value={{:end}}{{/if}}></div>
		  </div>
		</div>
	  </dd>

</script>


