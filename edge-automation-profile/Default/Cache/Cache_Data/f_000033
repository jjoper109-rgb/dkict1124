<!-- 콘텐츠 바디 : 환경설정 포워딩 아이템 -->
<script type="text/template" id="tmpl_content_body__mail_settings_forwarding_item">
  {{:~setvar("extns", _extns)}}
  {{for items}}
  <tr a-id="{{:id}}">
	<td>{{:address}}</td>
	<td>
	  {{!--
	  {{if code === "all"}}
		모든편지 전달
	  {{else code === "address"}}
		발송주소가 {{:data}} 인 경우만 전달
	  {{else code === "domain"}}
		발송도메인이 {{:data}} 인 경우만 전달
	  {{else code === "subject"}}
		제목에 {{:data}} 이(가) 포함되어 있을 경우 전달
	  {{/if}}
	  --}}
	  {{if code === "all"}}
		<!--모든편지 전달-->{{:~extns.ForwardAll}}
	  {{else code === "address"}}
		<!--발송주소가 {{:data}} 인 경우만 전달-->{{:~format(~extns.ForwardSendAddress, data)}}
	  {{else code === "domain"}}
		<!--발송도메인이 {{:data}} 인 경우만 전달-->{{:~format(~extns.ForwardShippingDomain, data)}}
	  {{else code === "subject"}}
		<!--제목에 {{:data}} 이(가) 포함되어 있을 경우 전달-->{{:~format(~extns.ForwardTitle, data)}}
	  {{/if}}
	</td>
	<td>{{if start && end}}{{:start}} ~ {{:end}}{{/if}}</td>
	<td>
	  <!--수정--><button type="button" class="button sm d-modify" title="{{:~dic('words.Modify')}}"><i class="icon-edit"></i></button>
	  <!--삭제--><button type="button" class="button sm d-delete" title="{{:~dic('words.Delete')}}"><i class="icon-trash-fill"></i></button>
	</td>
  </tr>
  {{/for}}
</script>
