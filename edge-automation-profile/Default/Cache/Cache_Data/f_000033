<script type="text/template" id="tmpl_layer_dialog_uploadAttachments">
  <div class="upload_state">
	<div class="total">
	  <dl class="state">
		<dt><!--전체 전송-->{{:_extns.FullTransfer}}</dt>
		<dd>
		  <div class="progress_area">
			<div class="progress"><div class="bar" style="width:0%;"></div></div>
			<strong class="count"><span class="d-percent">0<span>%</strong>
		  </div>
		</dd>
	  </dl>
	  <div class="info">
		<dl>
		  <dt><!--전송 파일-->{{:_extns.TransferFiles}}</dt>
		  <dd><span class="d-uploaded">0</span>/{{:total}}</dd>
