		<svg width="130" height="130">
		  <circle cx="65" cy="65" r="62" stroke-width="6" stroke="#e6e6e6" fill="none"></circle>
		  <circle cx="65" cy="65" r="62" stroke-width="6" stroke="#0b53a2" fill="none" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0,-1,1,0,0,130)"
