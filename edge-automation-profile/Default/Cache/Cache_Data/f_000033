			  <th><!--관리-->{{:_extns.Management}}</th>
			</tr>
		  </thead>
		  <tbody>
			<!--
			<tr>
			  <td>받은메일함</td>
			  <td><span class="txt size">100.2KB</span></td>
			  <td><span class="txt num"><em>3</em>/30</span></td>
			  <td>
				<button type="button" class="button sm" title="비우기" onclick="layer('#emptyMailBox')"><i class="icon-empty"></i><span>비우기</span></button>
				<button type="button" class="button sm" title="백업" onclick="layer('#mailBackup')"><i class="icon-history"></i><span>백업</span></button>
				<button type="button" class="button sm" title="모두읽음"><i class="icon-mail-open"></i><span>모두읽음</span></button>
			  </td>
			</tr>
