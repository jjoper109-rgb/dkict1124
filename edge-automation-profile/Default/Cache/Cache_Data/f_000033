/* 전체메뉴 위치변경으로 인하여 #gnb_icon .all_list 으로 되어있던 부분 #all_list 로 변경하여 스타일 추가 */
#all_list{ display:none; overflow:hidden; overflow-y:auto; position:fixed; z-index:400; top:0; right:0; bottom:0; left:0; padding:60px; background:rgba(255,255,255,0.5);}
#all_list:before{ position:fixed; top:0; right:0; bottom:0; left:0; background:rgba(0,0,0,0.7); content:"";}
#all_list h2{ position:relative; font-size:30px; color:#ffffff; text-align:center;}
#all_list p{ position:relative; margin:10px 0 40px; color:#00bcd4; text-align:center;}
#all_list ul{ position:relative; z-index:5;}
#all_list ul:after{ display:block; clear:both; content:"";}
#all_list ul li{ float:left; width:12.5%;}
#all_list a{ display:block; padding:22% 15px; font-size:13px; color:rgba(255,255,255,0.6); line-height:1; text-align:center; -webkit-transition:color 0.25s linear; transition:color 0.25s linear;}
#all_list a i{ font-size:40px; -webkit-transition:all 0.25s linear; transition:all 0.25s linear;}
#all_list a span{ display:block; margin-top:15px; font-size:13px; font-weight:700; white-space:nowrap; text-overflow:ellipsis;}
#all_list a:hover,#gnb_icon .all_list a:focus,#gnb_icon .all_list a:active{ border-radius:20px; color:#ffffff;}
#all_list a:hover i,#gnb_icon .all_list a:focus i,#gnb_icon .all_list a:active i{ -webkit-transform:scale(1.2); -ms-transform:scale(1.2); transform:scale(1.2);}
#all_list .close{ position:fixed; top:0; right:0; bottom:0; left:0;}

/* 환경설정 주소록 페이징 스타일 추가 */
.d-pagination-container { position: absolute; right: 0; bottom: 0; left: 0; background: #ffffff; }
.d-pagination-container:before { position: absolute; top: 0; right: 0; left: 0; height: 1px; background: #dddddd; content: ""; }
.d-pagination-container .paginate { margin-top: 0; }

/* 내용 항목의 기본 스타일로 표시되지 않는 항목 기본스타일로 표시되도록 스타일 추가(순번 안나오는 문제 및 링크 등등) */
.content_view ul, .content_view ol, .content_view li{
