<script type="text/template" id="tmpl_layer_loading">
  <div class="dataLoading">
		<div class="animation"><div class="one"></div><div class="two"></div><div class="three"></div></div>
	{{if _extns.format_message}}
		<p class="txt">{{:~format(_extns.format_message, _format_message)}}</p>
	{{else}}
	<p class="txt">{{:_extns.message}}</p>
	{{/if}}
	</div>
</script>
<!-- 레이어 다이얼로그 -->
<script type="text/template" id="tmpl_layer_dialog">
  <div class="ly_head">
	<h2 a-extn="title">
	  {{if _extns.format_title}}
		{{:~format(_extns.format_title, _format_title)}}
	  {{else}}
		{{:_extns.title}}
	  {{/if}}
	</h2>
  </div>
  <div class="ly_container">
	{{if _include}}
	<div class="ly_content" a-tmpl="{{:_include._tmpl}}" a-extn="{{:_include._extn}}">
	{{include _include tmpl=_include._tmpl/}}
	</div>
	{{else _extns.format_message}}
	<div class="ly_content" a-extn="message">{{:~format(_extns.format_message, _format_message)}}</div>
	{{else}}
	<div class="ly_content" a-extn="message">{{:_extns.message}}</div>
	{{/if}}
  </div>
  <div class="ly_foot" a-extn="buttons">
	{{for _extns.buttons}}
	<button type="button" class="button {{:class}}" title="{{:tooltip}}"{{if code}} a-extn-code="{{:code}}"{{/if}}>
	  {{if icon}}
	  <i class="{{:icon}}"></i><span>{{:text}}</span>
	  {{else}}
	  {{:text}}
	  {{/if}}
	</button>
	{{/for}}
  </div>
  <button type='button' class='button ly_close {{:_extns.borderIcons.close.class}}' title="{{:_extns.borderIcons.close.tooltip}}" a-extn="borderIcons.close" a-extn-code="mbClose">
	<i class='icon-close'></i>
  </button>
</script>
