		  <a class="btn_star icon-star{{if view.flags.indexOf('flagged') !== -1}}-fill{{/if}}"></a>
		  <h3>
			{{if view.important}}<i class="i_type icon-important"><span>중요메일</span></i>{{/if}}
			{{if view.lock}}<i class="i_type icon-lock"><span>보안메일</span></i>{{/if}}
			{{if view.folderText}}<em class="i_folderName">[{{:view.folderText}}]</em>{{/if}}
			<span class="d-subject">{{:view.subject}}</span>
		  </h3>
		</div>
		{{if view.labels && view.labels.length > 0}}
		<div class="i_labels">
		  {{for view.labels}}
		  <div class="ck_color" data-color="{{:color}}" a-code="{{:code}}"><a class="txt">{{>text}}</a><a class="close icon-close"></a></div>
		  {{/for}}
		</div>
		{{/if}}
		<dl class="info i_sender">
		  <dt><button type="button" class="btn_toggle on"><span>받는사람/참조 <em>보이기</em></span></button><!--보낸사람-->{{:~extns.From}}</dt>
		  <dd>
			<a class="mailAddress link_from" a-personal="{{>view.from.personal}}" a-address="{{>view.from.address}}">{{>~getInternetAddress(view.from.personal, view.from.address)}}</a>
			<span class="date">{{:view.date}}</span>
		  </dd>
		</dl>
		<dl class="info i_to">
		  <dt><!--받는사람-->{{:~extns.To}}</dt>
		  <dd>
			{{for view.to ~length=view.to.length}}
			  {{if #index < 5}}
				{{if #getIndex() > 0}}, {{/if}}<a class="mailAddress link_from" a-personal="{{>personal}}" a-address="{{>address}}">{{>~getInternetAddress(personal, address)}}</a>
			  {{else}}
				<a class="mailAddress link_from hide{{if #getIndex() === ~length - 1}} last{{/if}}" a-personal="{{>personal}}" a-address="{{>address}}"> , {{>~getInternetAddress(personal, address)}}</a>
			  {{/if}}
			{{/for}}
			{{if view.to.length > 5}}
			<span class="count"><!--외 {{:view.to.length - 5}}명-->{{:~format(~extns.To_Others, view.to.length - 5)}}</span>
			<a class='button more'><i class='icon-plus'></i><span>전체보기</span></a>
			{{/if}}
		  </dd>
		</dl>
		{{if view.cc}}
		<dl class="info i_to">
		  <dt><!--참조-->{{:~extns.Cc}}</dt>
		  <dd>
			{{for view.cc ~length=view.cc.length}}
			  {{if #index < 5}}
				{{if #getIndex() > 0}}, {{/if}}<a class="mailAddress link_from" a-personal="{{>personal}}" a-address="{{>address}}">{{>~getInternetAddress(personal, address)}}</a>
			  {{else}}
				<a class="mailAddress link_from hide{{if #getIndex() === ~length - 1}} last{{/if}}" a-personal="{{>personal}}" a-address="{{>address}}"> , {{>~getInternetAddress(personal, address)}}</a>
			  {{/if}}
			{{/for}}
			{{if view.cc.length > 5}}
			<span class="count"><!--외 {{:view.cc.length - 5}}명-->{{:~format(~extns.To_Others, view.cc.length - 5)}}</span>
			<a class='button more'><i class='icon-plus'></i><span>전체보기</span></a>
			{{/if}}

						{{!--
			{{for view.cc}}
			{{if #index > 0}},{{/if}}
			<a class="mailAddress link_from" a-personal="{{>personal}}" a-address="{{>address}}">{{>~getInternetAddress(personal, address)}}</a>
			{{/for}}
						--}}
		  </dd>
		</dl>
		{{/if}}
		{{if page.folder==='sent' && view.bcc}}
		<dl class="info i_to">
		  <dt><!--숨은참조-->{{:~extns.Bcc}}</dt>
		  <dd>
			{{for view.bcc ~length=view.bcc.length}}
			  {{if #index < 5}}
				{{if #getIndex() > 0}}, {{/if}}<a class="mailAddress link_from" a-personal="{{>personal}}" a-address="{{>address}}">{{>~getInternetAddress(personal, address)}}</a>
			  {{else}}
				<a class="mailAddress link_from hide{{if #getIndex() === ~length - 1}} last{{/if}}" a-personal="{{>personal}}" a-address="{{>address}}"> , {{>~getInternetAddress(personal, address)}}</a>
			  {{/if}}
			{{/for}}
			{{if view.bcc.length > 5}}
			<span class="count"><!--외 {{:view.bcc.length - 5}}명-->{{:~format(~extns.To_Others, view.bcc.length - 5)}}</span>
			<a class='button more'><i class='icon-plus'></i><span>전체보기</span></a>
			{{/if}}

						{{!--
			{{for view.bcc}}
			{{if #index > 0}},{{/if}}
			<a class="mailAddress link_from" a-personal="{{>personal}}" a-address="{{>address}}">{{>~getInternetAddress(personal, address)}}</a>
			{{/for}}
						--}}
		  </dd>
		</dl>
		{{/if}}
	  </div>
	  <div class="b_readView">
		<!-- 임시주석
		<div class="layer alert inner viewLoadingBar">
		  <div class="ly_box">
			<div class="dataLoading">
			  <div class="animation"><div class="one"></div><div class="two"></div><div class="three"></div></div>
			  <p class="txt">데이터 로딩중입니다. 잠시만 기다려주세요</p>
			</div>
		  </div>
		</div>
		-->
		<div class="readViewArea">
		  {{if view.attachments}}
		  <div class="b_file">
			<div class="f_info">
			  <button type="button" class="btn_toggle{{if !preferences.attachmentsFolding}} on{{/if}}"><span>첨부파일 <em>보이기</em></span></button>
			  <i class="icon-attach-file"></i><span class="txt"><strong><!--첨부파일 <em>{{:view.attachments.length}}개</em>-->{{:~format(~extns.Attachments, view.attachments.length)}}</strong> ({{:~byteUnit(~getAttachmentsSize(view.attachments))}})</span>
			  {{if view.attachmentsAll}}
			  <a class="button sm" href="{{:view.attachmentsAll.url}}" download><!--모두저장-->{{:~extns.SaveAll}}</a>
			  {{/if}}
			</div>
			<div class="file_list"{{if !preferences.attachmentsFolding}} style="display: block;"{{/if}}>
			  <ul>
				{{for view.attachments}}
				<li a-name="{{:name}}" a-size="{{:size}}">
				  {{if view}}
				  <button type="button" class="button none" a-view="{{:view}}"><i class="icon-eye-fill"></i><span>뷰어로 보기</span></button>
				  {{else}}
				  <button type="button" class="button none" style="cursor:default;"><i class="icon-download"></i><span>다운로드</span></button>
				  {{/if}}
				  <a class="name" href="{{:url}}" download>{{:name}}</a>
				  <u class="format">{{:~getFilenameExtension(name)}}</u>
				  <em class="size" a-size="{{:size}}">{{:~byteUnit(size)}}</em>
				</li>
				{{/for}}
			  </ul>
			</div>
		  </div>
		  {{/if}}
		  <div class="b_content">
			<div class="content_view">{{:view.body}}</div>
		  </div>
		  {{if view.previewImages}}
		  <div class="b_fileImg_preview">
			<h4><!--이미지 미리보기-->{{:~extns.PreviewImage}} <span>(<!--<em>1개</em>의 이미지가 있습니다.-->{{:~format(~extns.PreviewImage_Explanation, view.previewImages.length)}})</span></h4>
			<div class="list">
			  <ul>
				{{for view.previewImages}}
				<li>
				  <div class="img"><div class="inner"><a href="{{:url}}" target="_blank"><img src="{{:url}}" alt="{{:name}}"></a></div></div>
				  <div class="txt"><a>{{:name}}</a></div>
				</li>
				{{/for}}
			  </ul>
			</div>
		  </div>
		  {{/if}}
		</div>
	  </div>
	  <div class="b_moveTop"><a class="button"><i class="icon-arrow-top"></i>맨위로</a></div>
	</div>
  </div>
  {{if list === undefined}}
  </div>
  {{/if}}
</script>

