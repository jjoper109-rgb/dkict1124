/* checkbox radio */
.checkbox {
  display: inline-block;
  position: relative;
  height: 32px;
  padding-left: 32px;
  line-height: 1;
  vertical-align: middle;
  cursor: pointer;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

.checkbox input[type=checkbox], .checkbox input[type=radio] {
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
}

.checkbox i {
  position: absolute;
  top: 50%;
  left: 7px;
  width: 18px;
  height: 18px;
  margin-top: -9px;
  font-family: "eden_icon";
  font-size: 18px;
  color: #999999;
  line-height: 1;
  text-align: center;
}

.checkbox em, .checkbox span {
  display: inline-block;
  height: 32px;
  line-height: 32px;
  vertical-align: top;
}

.checkbox span {
  padding-right: 7px;
}

.checkbox strong {
  color: #fa3200;
}

.checkbox input:hover + i:before, .checkbox input:focus + i:before {
  color: #1fad9f;
}

.checkbox input:checked + i:before {
  color: #1fad9f;
}

.checkbox input[type=checkbox] + i:before {
  content: "";
}

.checkbox input[type=checkbox]:checked + i:before {
  content: "";
}

.checkbox input[type=radio] + i:before {
  content: "";
}

.checkbox input[type=radio]:checked + i:before {
  content: "";
}

.checkbox input:disabled + i, .checkbox input:disabled + i + span {
  color: #999999;
  cursor: not-allowed;
}

.checkbox input:disabled + i:before, .checkbox input:disabled:hover + i:before {
  color: #e6e6e6;
  content: "";
}

