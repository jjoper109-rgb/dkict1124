/* loading animation */
.dataLoading .animation {
  position: relative;
  line-height: 1;
  text-align: center;
}

.dataLoading .animation div {
  display: inline-block;
  width: 16px;
  height: 16px;
  margin: 0 2px;
  border-radius: 50%;
  background: #1fad9f;
  vertical-align: top;
  -webkit-animation: bounceDelay 1.4s infinite ease-in-out both;
  animation: bounceDelay 1.4s infinite ease-in-out both;
}

.dataLoading .animation .one {
  -webkit-animation-delay: -0.32s;
  animation-delay: -0.32s;
}

.dataLoading .animation .two {
  -webkit-animation-delay: -0.16s;
  animation-delay: -0.16s;
}

.dataLoading .txt {
  margin-top: 17px;
  font-size: 13px;
  color: #666666;
  white-space: nowrap;
}

@-webkit-keyframes bounceDelay {
  from, 80%, 100% {
    -webkit-transform: scale(0);
  }
  40% {
    -webkit-transform: scale(1);
  }
}
@keyframes bounceDelay {
  from, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}
