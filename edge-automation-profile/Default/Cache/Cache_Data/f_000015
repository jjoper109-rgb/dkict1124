/* upload attachments */
.upload_state {
  position: relative;
  width: 800px;
}

.upload_state:before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 45%;
  border-right: 1px dashed #e6e6e6;
  content: "";
}

.upload_state:after {
  display: block;
  clear: both;
  content: "";
}

.upload_state .total {
  float: left;
  width: 45%;
  padding-right: 20px;
  line-height: 1;
}

.upload_state .total dt {
  font-weight: 700;
}

.upload_state .total .state dt {
  margin-bottom: 10px;
}

.upload_state .total .state .progress_area {
  position: relative;
  padding-right: 40px;
}

.upload_state .total .state .progress_area .count {
  position: absolute;
  top: 0;
  right: 0;
  color: #1fad9f;
  line-height: 1;
}

.upload_state .total .info {
  margin-top: 15px;
}

.upload_state .total .info dl {
  overflow: hidden;
  position: relative;
}

.upload_state .total .info dl:before {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  border-top: 1px dashed #bbbbbb;
  content: "";
}

.upload_state .total .info dt {
  display: inline-block;
  position: relative;
  padding: 15px 10px 15px 0;
  background: #ffffff;
}

.upload_state .total .info dd {
  position: absolute;
  top: 0;
  right: 0;
  padding: 15px 0 15px 10px;
  background: #ffffff;
}

.upload_state .individual {
  float: right;
  width: 55%;
  padding-left: 20px;
}

.upload_state .individual h3 {
  margin-bottom: 10px;
  line-height: 1;
}

.upload_state .individual .list {
  overflow: hidden;
  height: 275px;
}

.upload_state .individual .dItem {
  position: relative;
  padding: 10px 10px 10px 50px;
  border-bottom: 1px dashed #e6e6e6;
}

.upload_state .individual .dItem .format {
  position: absolute;
  top: 8px;
  left: 0;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #1fad9f;
  font-family: "Tahoma";
  font-size: 10px;
  color: #ffffff;
  line-height: 36px;
  text-align: center;
  white-space: nowrap;
  text-transform: uppercase;
  text-overflow: ellipsis;
}

.upload_state .individual .dItem .name {
  overflow: hidden;
  margin-right: 130px;
  font-weight: 700;
  line-height: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.upload_state .individual .dItem .progress {
  margin-top: 10px;
}

.upload_state .individual .dItem .size {
  position: absolute;
  top: 10px;
  right: 10px;
  font-family: "Tahoma";
  font-size: 10px;
  color: #999999;
  line-height: 12px;
}

