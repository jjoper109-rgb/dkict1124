    else if (dictionary[prop.toLowerCase()])
      dictionary = dictionary[prop.toLowerCase()];
    else
      break;
    //console.log("dictionary:", dictionary);
  }
  //console.log("getDictionary(name):", name + ":" + dictionary);

  if (typeof dictionary === "string" || dictionary instanceof String)
    return dictionary;
  else
    return "";
}
