      //console.group("#content.c-view>.d-content-body .content_view a");

      //console.log($(this).attr("target"));
      if ($(this).attr("target") == undefined)
        $(this).attr("target", "_blank"); // 타겟 속성을 새창으로 지정

      //console.log($(this).attr("target"));
      //console.groupEnd();
    });

  });

