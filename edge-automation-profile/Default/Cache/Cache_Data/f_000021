      if (this.classList.contains("cur")) {
        return false;
      }

      var pagination = this.closest(".paginate");
      var no = parseInt(pagination.querySelector("li.cur").children[0].textContent);

      if (this.classList.contains("btn")) {

        if (this.classList.contains("first")) {
          no -= 10;
        } else if (this.classList.contains("prev")) {
          no -= 1;
        } else if (this.classList.contains("next")) {
          no += 1;
        } else if (this.classList.contains("last")) {
          no += 10;
        }

        var total = parseInt(pagination.getAttribute("a-total"));

        if (no < 1) {
          no = 1;
        } else if (no > total)
          no = total;

      } else {
        no = parseInt(this.children[0].textContent);
      }

      no = (no - 1) * 10 + 1;

      console.log("no:", no);

      /*
      var settings = Object.assign({}, _app.store.settings, mail_settings_addressbook__get(_app.store.token, no, no + 10));

      settings.pagination = (settings.items.length === 0) ? _app.getPagination(0) : _app.getPagination(no, 10, settings.totalCount);

      _app.renderContentBody({
        page: _app.store.page,
        data: settings,
      });

      _app.store.settings = settings;
      */

      var url = "";
      if (_app.store.options.search.word) {
        url = "/mail/settings/m:addressbook/n:" + no + "/sc:" + _app.store.options.search.code + "/sw:" + _app.store.options.search.word;
      } else {
        url = "/mail/settings/m:addressbook/n:" + no;
      }

      console.log("url:", url);
      _app.go(url, "push");

      console.groupEnd();
    });

    // 메일 본문 링크 중 타겟이 설정되어 있지 않다면 새창으로 열기 2020-12-11 김승태
