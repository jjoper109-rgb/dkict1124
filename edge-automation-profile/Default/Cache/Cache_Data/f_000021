// 배열 속성 값 중복 아이템 반환
function arrayPropValueExists(items, prop, value, ignoreProp, ignoreValue) {
  for (var i = 0, item; item = items[i]; i++) {
    if (ignoreProp) {
      if (item[ignoreProp] !== ignoreValue && item[prop] === value) {
        return item;
      }
    } else if (item[prop] === value) {
      return item;
    }

    if (item.items) {
      var retn = arrayPropValueExists(item.items, prop, value, ignoreProp, ignoreValue);
      if (retn) return retn;
    }
  }
}

function getExtension(templateId) {
  return _app.locale.extension[templateId];
}

function getFolder(items, code) {

  for (var i = 0, item; item = items[i]; i++) {
    if (item.code === code) {
      return item;
    } else if (item.items) {
      var retn = getFolder(item.items, code);
      if (retn) return retn;
    }
  }

}

function folder__remove(items, code) {
  for (var i = 0, item; item = items[i]; i++) {
    if (item.code === code) {
      items.splice(i, 1);
      return 1;
    } else if (item.items) {
      if (folder__remove(item.items, code)) return 1;
    }
  }
  return 0;
}




function uuidv4() {
  var d = new Date().getTime();
  if (typeof performance !== 'undefined' && typeof performance.now === 'function') {
    d += performance.now(); //use high-precision timer if available
  }
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
    var r = (d + Math.random() * 16) % 16 | 0;
    d = Math.floor(d / 16);
    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
  });
}



