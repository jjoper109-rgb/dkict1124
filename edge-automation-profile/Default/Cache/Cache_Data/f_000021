function getInternetAddress(personal, address, condition) {
  switch (condition) {
    case "personal":
      return (personal) ? personal : address;
    default:
      //return (personal) ? personal + " &lt;" + address + "&gt;" : address;
      if (address.indexOf(':') > -1)
        return (personal) ? personal + address : address;
      else
        return (personal) ? personal + " <" + address + ">" : address;
  }
}

