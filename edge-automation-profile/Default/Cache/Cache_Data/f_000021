function ui_addressbox__blur(src) {
  console.group("ui_addressbox__blur(src)");

  var addressbox = src.parentElement;
  var em = addressbox.querySelector("em");


  if (src.value !== em.textContent) {
    var personal, address;

    var tmp = src.value.trim();
    var pos = tmp.lastIndexOf(" ");

    if (pos === -1)
      pos = tmp.lastIndexOf("<");

    if (pos > 0) {
      personal = tmp.substring(0, pos).trim();
      address = tmp.substring(pos + 1).trim();
    } else {
      address = tmp.trim();
      personal = "";
    }

    if (address.charAt(0) == "<")
      address = address.substring(1);
    if (address.charAt(address.length - 1) == ">")
      address = address.substring(0, address.length - 1);

    if (address.search(/^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/) === -1)
      addressbox.classList.add("invalid");
    else
      addressbox.classList.remove("invalid");

    src.value = getInternetAddress(personal, address);

    // 입력 컨트롤이 받는 사람인 경우
    if (addressbox.closest(".item").classList.contains("i_recipient")) {
      var content_body = addressbox.closest(".d-content-body");
      var sender = content_body.querySelector(".i_sender>dd");
      //var sender_address = getInternetAddress(sender.querySelector("input.int").value, sender.querySelector(".dd_toggle>b").textContent);
      var sender_address = getInternetAddress(sender.querySelector("input.int").value, sender.querySelector("b").textContent);

      if (sender_address === em.textContent && sender_address !== src.value)
        content_body.querySelector(".b_option .d-me").checked = false;
    }

    em.textContent = src.value;
  }

  src.setAttribute("type", "hidden");
  addressbox.classList.remove("edit_address");

  console.groupEnd();
}


