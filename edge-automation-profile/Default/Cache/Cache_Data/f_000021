    $container.on("click", "#content.c-view .d-content-head .d-move .d-append", function () {
      console.group("(#content.c-view .d-content-head .d-move .d-append).click()");
      //console.log("this:", this);

      var text = this.previousElementSibling.value.trim();
      var code = uuidv4().replace(/-/gi, "");

      var regexp = new RegExp('[^가-힣a-zA-Z0-9\_\-]', 'i');
      console.log('regexp.exec(text):', regexp.exec(text));

      // 이름 중복 확인
      if (arrayPropValueExists(_app.store.folders.private, 'text', text, 'code', code)) {
        _app.renderDialog(document.body, "#tmpl_layer_dialog", "___validateNameAlreadyExists");
      } else if (text === "") {
        _app.renderDialog(document.body, "#tmpl_layer_dialog", "___nameNotFound");
      } else if (regexp.exec(text)) {
        _app.renderDialog(document.body, "#tmpl_layer_dialog", "___validateNameInvalid");
      } else {

        if (text) {
          if (mail_folder__create(code, text)) {
            var item = {
              code: code,
              text: text,
              type: "box",
              unseen: 0
            };
            _app.store.folders.private.push(item);
            _app.store.folders.privateFlat = _app.getPrivateFolderFlatList(_app.store.folders.private, new Array());

            // 개인폴더의 아이템을 추가 합니다.
            _app.renderTemplate("#myMailBox>ul", "#tmpl_drawer_treemenu_item", item);

            var li = document.createElement("li");
            var a = document.createElement("a");
            a.setAttribute("a-code", code);
            a.appendChild(document.createTextNode(text));
            li.appendChild(a);
            var ul = this.closest(".dd_content").querySelector("ul");
            ul.appendChild(li);
            ul.scrollTo(0, ul.scrollHeight);

            this.previousElementSibling.value = "";
          } else {
            _app.renderDialog(document.body, "#tmpl_layer_dialog", "___warning___createFolder");
          }
        } else {
          _app.renderDialog(document.body, "#tmpl_layer_dialog", "___validate___folderNameNotFound");
        }

      }

      console.groupEnd();
    });
