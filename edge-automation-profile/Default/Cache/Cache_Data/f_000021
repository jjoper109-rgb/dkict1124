  _.updateTabmenu = function (data) {
    console.group("_.updateTabmenu(data)");
    console.log("data:", data);

    var maxWidth = this.vdom.tabmenu.offsetWidth - 70;
    var curWidth = 0;
    var ul = this.vdom.tabmenu.querySelector(".more>ul");

    for (var i = ul.children.length - 1; i > -1; i--) {
      ul.removeChild(ul.children[i]);
    }
    this.vdom.tabmenu.querySelectorAll(".list>li.menu").forEach(function (it) {
      curWidth += it.offsetWidth;
      if (curWidth > maxWidth) {
        var li = document.createElement("li");
        li.appendChild(it.children[0].cloneNode(true));
        ul.appendChild(li);
        it.style.display = "none";
      } else {
        // ie 에서 style.display = null 로 적용 안됨
        //it.style.display = null;
        it.style.display = "";
      }
    });

    if (ul.children.length > 0) {
      ul.closest(".more").classList.add("on");
    } else {
      ul.closest(".more").classList.remove("on");
    }

    console.groupEnd();
  };
