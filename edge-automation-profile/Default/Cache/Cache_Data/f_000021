// 바이트 단위 반환 함수
function byteUnit(bytes) {
  //console.log("byteUnit(bytes: " + bytes + ")");
  if (bytes === 0) return "0";

  //const u = ['바이트', '킬로바이트', '메가바이트', '기가바이트', '테라바이트', '페타바이트', '엑사바이트'];
  var u = ["B", "KB", "MB", "GB", "TB", "PB", "EB"];
  var i = 0;
  var n = bytes;
  while (n >= 1024) {
    n = n / 1024;
    i++;
  }
  if (i > 0) { 
    // 소수점 두자리 내림차순으로 변경 2020-01-22 김승태
    //n = n.toFixed(2);
    	n = Math.floor(n*100)/100;
  }

  //console.log(n + " " + u[i]);

  return n + " " + u[i];
}
