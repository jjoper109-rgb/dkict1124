  _.getCookie = function (name) {
    var value = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
    return value ? value[2] : null;
  };
  // 객체 비교 함수
  _.equals = function (x, y, ignores) {
    if (!ignores) ignores = [];
    for (var prop in x) {
      //console.log("prop:", prop);
      //console.log("x[prop]:", x[prop]);
      //console.log("y[prop]:", y[prop]);
      if (typeof (x[prop]) === "object") {
        if (!this.equals(x[prop], y[prop], ignores)) {
          return false;
        }
      } else if (ignores.indexOf(prop) === -1 && x[prop] !== y[prop])
        return false;
    }
    return true;
  };
  // 쿼리 문자열 반환 함수
  _.getQueryString = function (type) {

    var get = undefined;

    switch (type) {
      case "[array]":
        get = new Array();
        break;
      default:
        get = new Object();
        break;
    }

    var tmp = window.location.search;
    if (tmp === "") {
      return get;
    }
    var arr = tmp.substring(1).split("&");

    for (var i = 0, l = arr.length; i < l; i++) {
      tmp = arr[i].split("=");
      if (Array.isArray(get))
        get.push({
          name: decodeURIComponent(tmp[0]),
          value: decodeURIComponent(tmp[1])
        });
      else
        get[decodeURIComponent(tmp[0])] = decodeURIComponent(tmp[1]);
    }

    //if (typeof args[2] === "string" || args[2] instanceof String) {
    if (type && type !== "[array]") {
      return get[type];
    } else
      return get;
  };
