  // 템플릿 렌더 함수
  // Internet Explorer 에서 function (...args) 지원되지 않음
  //function renderTemplate(...args) {
  _.renderTemplate = function () {
    var args = Array.prototype.slice.call(arguments, this.renderTemplate.length);

    var params = null;
    switch (args.length) {
      case 1:
        //console.group("renderTemplate(model)");
        //console.log("model:", args[0]);
        params = args[0];
        var obj = params;
        while (obj) {
          for (var prop in obj) {
            if (prop === "_data") {
              for (prop in obj["_data"]) {
                obj[prop] = obj["_data"][prop];
              }
              delete obj["_data"];
            }
          }
          obj = obj._include;
        }
        break;
      case 2:
        //console.group("renderTemplate(target, template)");
        //console.log("target:", args[0]);
        //console.log("template:", args[1]);
        params = {
          _target: args[0],
          _tmpl: args[1]
        };
        break;
      case 3:
        if (typeof args[2] === "string" || args[2] instanceof String) {
          //console.group("renderTemplate(target, template, extension)");
          //console.log("target:", args[0]);
          //console.log("template:", args[1]);
          //console.log("extension:", args[2]);
          params = {
            _target: args[0],
            _tmpl: args[1],
            _extn: args[2]
          };
        } else {
          //console.group("renderTemplate(target, template, data)");
          //console.log("target:", args[0]);
          //console.log("template:", args[1]);
          //console.log("data:", args[2]);
          params = {
            _target: args[0],
            _tmpl: args[1],
          };
          for (var prop in args[2]) {
            params[prop] = args[2][prop];
          }
        }
        break;
      default:
        break;
    }

    var obj = params;
    var temp = null;
    var i18n = null;
    while (obj) {
      temp = this.locale.extension[obj._tmpl.substring(1)];
      ////console.log("_locale.templates", _locale.templates);
      if (temp) {
        i18n = {};
        for (var prop in temp) {
          ////console.log("temp.prop:", prop);
          if (prop.indexOf("___") === -1)
            i18n[prop] = temp[prop];
        }
        if (obj._extn) {
          temp = temp[obj._extn];
          for (var prop in temp) {
            ////console.log("extn.prop:", prop);
            if (prop.indexOf("___") === -1)
              i18n[prop] = temp[prop];
          }
        }
        obj._extns = i18n;
      }
      obj = obj._include;
    }

    /*
    //console.log("model:", model);

    // data 에 items 만 있고 i18n 이 없고 dict 가 없는 경우
    // (tmpl_drawer__mail_drawer_personalFolders 에서 제귀호출 사용)
    if (model.data && model.data.items && !model.i18n && !model.dict) {
      model.items = model.data.items;
      delete model.data;
    }
    */

    console.log("params:", params);

    var tmpl = $.templates(params._tmpl);
    var html = tmpl.render(params);
    ////console.log(html);

    //console.groupEnd();

    if (params._target) {
      return $(html).appendTo(params._target)[0];
    } else
      return html;
  };
